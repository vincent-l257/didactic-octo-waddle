# The sm_70 cubins a compute capability 7.0 card runs (include/basalt/kernels/cc_launch.hpp). CUDA 13 dropped sm_70,
# so they are built by a CUDA 12.x nvcc given as BASALT_SM70_NVCC, one cubin per CUDA source of the listed targets,
# into `sm70/` beside the executables. Empty BASALT_SM70_NVCC: no cubins, and a cc 7.0 card is refused at startup.
set(BASALT_SM70_NVCC "" CACHE FILEPATH "CUDA 12.x nvcc for the sm_70 cubins (empty: none)")
set(BASALT_SM70_INCLUDES "" CACHE STRING "include directories of that toolkit, when not <nvcc>/../include")

function(basalt_sm70_cubins)
  cmake_parse_arguments(A "" "OUT" "TARGETS;EXCLUDE" ${ARGN})
  if(NOT BASALT_SM70_NVCC)
    return()
  endif()
  get_filename_component(_bin "${BASALT_SM70_NVCC}" DIRECTORY)
  set(_inc ${BASALT_SM70_INCLUDES})
  if(NOT _inc)
    set(_inc "${_bin}/../include")
  endif()
  set(_flags -cubin -arch=sm_70 -std=c++20 -O3 -DNDEBUG -DBASALT_VERSION="${PROJECT_VERSION}"
             -Wno-deprecated-gpu-targets --allow-unsupported-compiler -I${CMAKE_SOURCE_DIR}/include)
  foreach(_d IN LISTS _inc)
    list(APPEND _flags -I${_d})
  endforeach()
  # the newer toolkit's headers last: the host-side declarations the sources include beside the runtime's
  foreach(_d IN LISTS CUDAToolkit_INCLUDE_DIRS)
    list(APPEND _flags -I${_d})
  endforeach()
  if(MSVC)
    list(APPEND _flags -Xcompiler=/EHsc,/Zc:__cplusplus,/Zc:preprocessor,/utf-8,/bigobj)
  endif()
  # every header: a header change rebuilds the cubins (no per-source dependency scan for a custom command)
  file(GLOB_RECURSE _hdrs CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/include/*.hpp" "${CMAKE_SOURCE_DIR}/include/*.cuh"
       "${CMAKE_SOURCE_DIR}/include/*.h" "${CMAKE_SOURCE_DIR}/src/*.cuh" "${CMAKE_SOURCE_DIR}/src/*.hpp")
  set(_outs)
  foreach(_t IN LISTS A_TARGETS)
    get_target_property(_srcs ${_t} SOURCES)
    get_target_property(_topts ${_t} COMPILE_OPTIONS)
    foreach(_s IN LISTS _srcs)
      if(NOT _s MATCHES "\\.cu$")
        continue()
      endif()
      get_filename_component(_name "${_s}" NAME)
      if(_name IN_LIST A_EXCLUDE)
        continue()
      endif()
      get_source_file_property(_sopts "${_s}" COMPILE_OPTIONS)
      set(_extra)
      if("${_sopts};${_topts}" MATCHES "fast_math")
        list(APPEND _extra --use_fast_math)
      endif()
      if("${_topts}" MATCHES "extended-lambda")
        list(APPEND _extra --extended-lambda)
      endif()
      string(REGEX REPLACE "^src/" "" _rel "${_s}")
      string(REPLACE "/" "_" _rel "${_rel}")
      string(REGEX REPLACE "\\.cu$" ".sm_70.cubin" _rel "${_rel}")
      set(_o "${A_OUT}/${_rel}")
      add_custom_command(OUTPUT "${_o}"
        COMMAND "${BASALT_SM70_NVCC}" ${_flags} ${_extra} -o "${_o}" "${CMAKE_SOURCE_DIR}/${_s}"
        DEPENDS "${CMAKE_SOURCE_DIR}/${_s}" ${_hdrs}
        COMMENT "sm_70 ${_name}"
        VERBATIM)
      list(APPEND _outs "${_o}")
    endforeach()
  endforeach()
  file(MAKE_DIRECTORY "${A_OUT}")
  add_custom_target(sm70_cubins ALL DEPENDS ${_outs})
endfunction()
